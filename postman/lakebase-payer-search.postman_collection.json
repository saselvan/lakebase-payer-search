              "const rows = pm.response.json();",
              "pm.test('finds a Blue Cross plan in Georgia', () => pm.expect(rows[0].payer_name).to.match(/Blue Cross.*(GA|Georgia)/));"
            ]
          }
        }
      ]
    },
