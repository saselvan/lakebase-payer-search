    {
      "name": "9. Read a table directly -> refused",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{data_api_base}}/payer_serving/insurer_alias?limit=1",
          "host": [
            "{{data_api_base}}"
          ],
          "path": [
            "payer_serving",
            "insurer_alias"
          ],
          "query": [
            {
              "key": "limit",
              "value": "1"
            }
          ]
        },
        "description": "The service principal can only execute the search function. Tables are not exposed.",
        "auth": {
          "type": "bearer",
          "bearer": [
