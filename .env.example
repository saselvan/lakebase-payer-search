# Copy to .env and fill in. .env is git-ignored. No secrets in the repo.
DATABRICKS_PROFILE=my-profile            # ~/.databrickscfg profile used for setup (admin)
LAKEBASE_PROJECT=payer-search-demo
LAKEBASE_BRANCH=production
LAKEBASE_ENDPOINT=primary
PG_DATABASE=databricks_postgres
UC_CATALOG=my_catalog
UC_SCHEMA=payer_serving
SQL_WAREHOUSE_ID=
# Filled by scripts/setup: the caller service principal
SP_APPLICATION_ID=
SP_CLIENT_SECRET=
# Data API base, e.g. https://<host>/api/2.0/workspace/<workspace-id>/rest/<database>
DATA_API_BASE=
WORKSPACE_HOST=
