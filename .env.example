# Copy to .env and fill in. .env is git-ignored; never commit it.
# What each value is and where to find it: docs/deploy.md, section ".env values".
# Keep values free of spaces, quotes, < and > (setup.sh reads this file with bash).

# --- Setup identity: you, an admin, on your laptop ---
DATABRICKS_PROFILE=my-profile                   # a profile in ~/.databrickscfg (databricks auth login --profile my-profile)
WORKSPACE_HOST=https://your-workspace-host      # your workspace URL, as in the browser address bar

# --- Lakebase: must match the bundle (databricks.yml) ---
LAKEBASE_PROJECT=lakebase-payer-search          # the bundle's lakebase_project variable (this is its default)
LAKEBASE_BRANCH=production                      # made with the project
LAKEBASE_ENDPOINT=primary                       # made with the project
PG_DATABASE=databricks_postgres                 # made with the project

# --- Unity Catalog source data ---
UC_CATALOG=main                                 # a catalog where you can CREATE SCHEMA
UC_SCHEMA=payer_search                          # setup creates it; do NOT use payer_serving (the synced table goes there)
SQL_WAREHOUSE_ID=                               # SQL Warehouses > your warehouse > Connection details > the id after /warehouses/

# --- The calling app's identity: a service principal ---
SP_APPLICATION_ID=                              # Settings > Identity and access > Service principals > Application ID
SP_CLIENT_SECRET=                               # same page > Secrets > Generate secret (shown once; use a secret store in production)

# --- Filled after setup ---
DATA_API_BASE=                                  # printed by: uv run python scripts/enable_data_api.py
